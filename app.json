
{
  "expo": {
    "name": "FitsForYou",
    "slug": "FitsForYou",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "FitsForYou uses your location to provide local weather information."
      }
    },
    "android": {
      "package": "com.fitsforyou.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#000000"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow FitsForYou to access your location to provide local weather information."
        }
      ]
    ]
  }
}
